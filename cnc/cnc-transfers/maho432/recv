#!/usr/bin/env python3
"""
recv — обгортка над `./maho432 recv` цього каталогу.

Навіщо вона тут, якщо нічого не підставляє. Заради однакової будови каталогів:
у кожному верстаті команди звуться однаково — `./send`, `./recv`, — і біля
верстата не треба згадувати, у якого з них інструмент зветься `traub`, у якого
`sinumerik`, а в якого `maho432`.

Чому не над `sniff`, як у каталозі Sinumerik. Там прийом і є розбором знятого
з лінії: `sniff` віддає байти, `recv` знімає біт парності — і все. Тут прийом
робить більше, ніж може чистий слухач:

  * рахує парність і при збоях віддає код виходу 2 — таку стрічку не можна
    заливати назад у верстат;
  * пише поруч байт-точний `.raw` із бітами парності. Для цього верстата це
    найважливіше: канонічного формату його виводу ми ще не знаємо, а цеховий
    DNC саме ці байти й стирає (`Remove characters: All below ASCII 32`);
  * друкує найдовшу паузу всередині передачі проти `--idle`.

Тобто так само, як у `traub`: `sniff` лишається чистою діагностикою лінії, а
прийом іде через двигун каталогу — так само, як `./send` іде через нього ж.

Нічого не підставляє: типові значення інструмента вже зняті з цехового профілю
(`--idle 5` — його Receive timeout; DC1 не шлеться — там знято Send XOn).

Що вона таки робить: друкує повну команду перед запуском.
"""
import os, subprocess, sys

HERE = os.path.dirname(os.path.realpath(__file__))
TOOL = os.path.join(HERE, "maho432")

# Прапорці самого інструмента, а не підкоманди: мусять стояти ПЕРЕД словом
# `recv`, інакше argparse відмовляє. Значення True = прапорець зі значенням.
GLOBAL = {"--port": True, "--baud": True, "--no-dtr": False}

HELP = """usage: recv [options] [FILE]

Receive an NC program from the MAHO MH 600 C (Philips/MAHO CNC 432-9).
Wrapper around './maho432 recv'.

NOTHING HERE HAS BEEN TRIED ON THE MACHINE YET. The line settings come from
the shop's Windows DNC; see NOTES.md for what is fact and what is a guess.

Without FILE the program lands in tapes/ as prog_<date>_<size>B.nc. With FILE
it lands exactly there. Either way the byte-exact archive is written next to
it as FILE.raw. An existing file is never overwritten.

Two files every time: .raw keeps the parity bits and every control byte as
they came off the wire, .nc has parity stripped and line endings normalised
to CRLF. The .raw is not an archive for its own sake -- the real format of
this control's output is still unknown, and that file is the only place it
can be read from.

A file with parity errors is written but reported, and the exit code is 2 --
do not send it back to the machine.

Substitutes nothing: the tool's defaults are taken straight from the shop
profile. Note --idle 5 s is the ONLY end-of-transfer criterion we have for
this control so far: silence. If the machine pauses mid-program for longer
than that, the receive ends early and still looks like success -- the tool
prints the longest gap it saw, so watch that number.

Options are passed through unchanged -- see './maho432 recv --help'.

Run this FIRST, then start the output on the control.
"""


def main():
    argv = sys.argv[1:]

    # Порожній виклик — нормальна робоча команда, а не помилка: імʼя файлу тут
    # необовʼязкове. Цим `recv` відрізняється від `send`, якому файл потрібен.
    if "-h" in argv or "--help" in argv:
        print(HELP, end="")
        return 0

    if not os.access(TOOL, os.X_OK):
        sys.exit(f"tool not found or not executable: {TOOL}")

    out, glob = [], []
    skip = -1
    for k, a in enumerate(argv):
        if k == skip:
            continue
        base = a.split("=", 1)[0]
        if base in GLOBAL:
            glob.append(a)
            if GLOBAL[base] and "=" not in a:
                if k + 1 >= len(argv):
                    sys.exit(f"{a} needs a value")
                glob.append(argv[k + 1])
                skip = k + 1
            continue
        out.append(a)

    cmd = [TOOL] + glob + ["recv"] + out
    print("+ " + " ".join(cmd), flush=True)
    return subprocess.call(cmd)


if __name__ == "__main__":
    sys.exit(main())
